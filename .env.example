# Copy this file to .env and adjust if needed. All values below are the working defaults.

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True

# External services (no API keys required)
# Nominatim = free OpenStreetMap geocoder (turns "Chicago, IL" into lat/lng)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OSRM = free routing engine (returns the driving route geometry + distance in ONE call)
OSRM_URL=https://router.project-osrm.org/route/v1/driving
# Nominatim's usage policy requires a descriptive User-Agent identifying your app
HTTP_USER_AGENT=fuel-route-api/1.0 (assessment)

# Vehicle assumptions from the assessment brief
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10

# How close (miles) a station must be to the route to be considered a candidate stop
ROUTE_BUFFER_MILES=10
